{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "noEmit": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "sourceMap": true,

    "noUncheckedIndexedAccess": true
  },

  "include": [
    "playwright.config.ts",
    "tests/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}